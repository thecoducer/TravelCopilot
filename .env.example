# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# ── LLM ──────────────────────────────────────────────────────────────────────
# Swap provider + model with two vars, zero code changes. Set the matching key.
#   openai      / gpt-4o                              -> OPENAI_API_KEY
#   gemini      / gemini-1.5-pro                      -> GOOGLE_API_KEY
#   anthropic   / claude-3-5-sonnet-20241022           -> ANTHROPIC_API_KEY
#   groq        / llama3-70b-8192                     -> GROQ_API_KEY
#   openrouter  / nvidia/nemotron-3-ultra-550b-a55b:free -> OPEN_ROUTER_API_KEY
#   ollama      / llama3   (local, free)              -> LLM_API_BASE=http://localhost:11434
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Provider API keys (fill in only the one matching LLM_PROVIDER above)
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=            # Gemini / Vertex AI
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=       # OpenRouter (note: different from OPENROUTER_API_KEY used by LiteLLM internally)

# Optional: base URL for local / self-hosted models (Ollama, vLLM, etc.)
LLM_API_BASE=

# ── Mock flag (set true during dev to avoid real API calls) ──────────────────
MOCK_EXTERNAL_APIS=true

# ── External Search APIs ─────────────────────────────────────────────────────
SERPAPI_KEY=
TAVILY_API_KEY=

# ── Maps & Places ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Weather ───────────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=

# ── Currency Exchange ─────────────────────────────────────────────────────────
FX_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# docker-compose exposes postgres on host port 5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/travelcopilot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Langfuse (self-hosted local) ──────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ── OpenTelemetry (optional) ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=travelcopilot-backend

# ── Clarification gate ────────────────────────────────────────────────────────
CLARIFICATION_REQUIRED_FIELDS=destination,dates,travelers
PARSE_CONFIDENCE_THRESHOLD=0.6

# ── Budget guard ──────────────────────────────────────────────────────────────
MAX_LLM_SPEND_USD_PER_TRIP=1.00
