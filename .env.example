# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# ── LLM ──────────────────────────────────────────────────────────────────────
# Swap provider + model with two vars, zero code changes. Set the matching key.
#   openai      / gpt-4o                              -> OPENAI_API_KEY
#   gemini      / gemini-1.5-pro                      -> GOOGLE_API_KEY
#   anthropic   / claude-3-5-sonnet-20241022           -> ANTHROPIC_API_KEY
#   groq        / llama3-70b-8192                     -> GROQ_API_KEY
#   openrouter  / nvidia/nemotron-3-ultra-550b-a55b:free -> OPEN_ROUTER_API_KEY
#   ollama      / llama3   (local, free)              -> LLM_API_BASE=http://localhost:11434
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Provider API keys (fill in only the one matching LLM_PROVIDER above)
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=            # Gemini / Vertex AI
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=       # OpenRouter (note: different from OPENROUTER_API_KEY used by LiteLLM internally)

# Optional: base URL for local / self-hosted models (Ollama, vLLM, etc.)
LLM_API_BASE=

# LLM runtime guards — reasoning-heavy models (DeepSeek, o-series) stall without these
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_NUM_RETRIES=2
LLM_MAX_RETRIES=1
# json_schema | function_calling | json_mode  (blank = provider default)
LLM_STRUCTURED_OUTPUT_METHOD=json_schema

# ── Mock flag (set true during dev to avoid real API calls) ──────────────────
MOCK_EXTERNAL_APIS=true

# ── Tool response capture and shared HTTP runtime ───────────────────────────
TOOL_RESPONSE_RECORDING_ENABLED=false
TOOL_RESPONSE_DIR=backend/tool_responses
TOOL_RESPONSE_RETENTION_DAYS=30
EXTERNAL_API_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_API_READ_TIMEOUT_SECONDS=20
EXTERNAL_API_WRITE_TIMEOUT_SECONDS=10
EXTERNAL_API_POOL_TIMEOUT_SECONDS=5
EXTERNAL_API_MAX_RETRIES=3
EXTERNAL_API_MAX_KEEPALIVE_CONNECTIONS=20
EXTERNAL_API_MAX_CONNECTIONS=100
EXTERNAL_API_KEEPALIVE_EXPIRY_SECONDS=5
EXTERNAL_API_PROVIDER_CONCURRENCY=5
EXTERNAL_API_RETRYABLE_STATUS_CODES=408,429,500,502,503,504
EXTERNAL_API_RETRY_BASE_DELAY_SECONDS=0.5
EXTERNAL_API_RETRY_MAX_DELAY_SECONDS=8

# ── External Search APIs ─────────────────────────────────────────────────────
SERPAPI_KEY=
TAVILY_API_KEY=
SERPAPI_SEARCH_URL=https://serpapi.com/search.json
SERPAPI_DEFAULT_LANGUAGE=en
SERPAPI_DEFAULT_COUNTRY=us
SERPAPI_DEFAULT_ADULTS=1
SERPAPI_DEFAULT_HOTEL_ADULTS=2
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_DEFAULT_SEARCH_DEPTH=basic
TAVILY_DEFAULT_MAX_RESULTS=5
TAVILY_DEFAULT_LANGUAGE=en

# ── Maps & Places ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_API_KEY=
GOOGLE_PLACES_SEARCH_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_PLACES_DETAILS_URL=https://places.googleapis.com/v1/places
GOOGLE_ROUTES_URL=https://routes.googleapis.com/directions/v2:computeRoutes
GOOGLE_ROUTE_MATRIX_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix
GOOGLE_GEOCODE_URL=https://geocode.googleapis.com/v4/geocode/address
GOOGLE_ROUTES_MAX_MATRIX_ELEMENTS=625
GOOGLE_ROUTES_MAX_TRANSIT_MATRIX_ELEMENTS=100
GOOGLE_ROUTES_MAX_MATRIX_ADDRESS_COUNT=50

# ── Currency Exchange ─────────────────────────────────────────────────────────
FX_API_KEY=
OPEN_EXCHANGE_RATES_LATEST_URL=https://openexchangerates.org/api/latest.json

# ── Database ──────────────────────────────────────────────────────────────────
# docker-compose exposes postgres on host port 5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/travelcopilot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Langfuse (self-hosted local) ──────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ── OpenTelemetry (optional) ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=travelcopilot-backend

# ── Clarification gate ────────────────────────────────────────────────────────
CLARIFICATION_REQUIRED_FIELDS=source,destination,dates,trip_days,travelers,budget
CLARIFICATION_FIELD_THRESHOLDS=source:0.3,destination:0.7,dates:0.6,trip_days:0.7,travelers:0.4,budget:0.7
CLARIFICATION_ALLOWED_FIELDS=source,destination,dates,trip_days,travelers,budget,query,preferred_cuisines,dietary_restrictions,visa_application_city
CLARIFICATION_MAX_QUESTIONS=6
CLARIFICATION_MAX_OPTIONAL_QUESTIONS=3
CLARIFICATION_MAX_PROMPT_LENGTH=500
PARSE_CONFIDENCE_THRESHOLD=0.6
MAX_CLARIFICATION_ROUNDS=3
# Skippable preference questions add an extra interrupt/resume cycle — opt in explicitly
ENABLE_OPTIONAL_CLARIFICATION=false

# ── Route discovery ──────────────────────────────────────────────────────────
MAX_GATEWAY_OPTIONS=2

# ── Budget guard ──────────────────────────────────────────────────────────────
MAX_LLM_SPEND_USD_PER_TRIP=1.00
DEFAULT_CURRENCY=INR
DEFAULT_BUDGET_TIER=mid
DEFAULT_TRIP_DAYS=3
BUDGET_OVER_THRESHOLD_MULTIPLIER=1.1
BUDGET_UNDER_THRESHOLD_MULTIPLIER=0.9
FALLBACK_DAILY_ACTIVITY_COST_BUDGET=500
FALLBACK_DAILY_ACTIVITY_COST_MID=1500
FALLBACK_DAILY_ACTIVITY_COST_LUXURY=4000
FALLBACK_DAILY_FOOD_RATIO=0.35
